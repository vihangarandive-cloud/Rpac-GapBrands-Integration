<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!-- Configure AspNetCoreModule to run Uvicorn as a workaround -->
    <aspNetCore processPath=".\venv\Scripts\python.exe" arguments="-m uvicorn app:app --host 127.0.0.1 --port %ASPNETCORE_PORT%" stdoutLogEnabled="true" stdoutLogFile=".\logs\python.log" startupTimeLimit="60" processesPerApplication="1">
      <environmentVariables>
        <!-- The PORT environment variable is automatically provided by AspNetCoreModule -->
        <environmentVariable name="PORT" value="%ASPNETCORE_PORT%" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
    <system.web>
        <identity impersonate="false" />
    </system.web>
</configuration>
<!-- restart trigger 1785754629 -->

